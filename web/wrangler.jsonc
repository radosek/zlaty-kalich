{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boxb",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "boxb-media" }],
  "observability": { "enabled": true }
}
